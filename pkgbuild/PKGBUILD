pkgname=spire
pkgver=0.1.0
pkgrel=1
pkgdesc='Progress billing for contractors: schedule of values, pay applications (G702/G703), change orders, retainage'
url='https://github.com/yamz8/spire'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/spire "$pkgdir/usr/bin/spire"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/spire.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/spire.svg"
  install -Dm644 "$startdir/spire.desktop" "$pkgdir/usr/share/applications/spire.desktop"
  install -Dm644 "$startdir/spire.xml" "$pkgdir/usr/share/mime/packages/spire.xml"
}
